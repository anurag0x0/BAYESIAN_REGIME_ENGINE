{
    "model": "MC Dropout Bayesian Neural Network",
    "input_dim": 24,
    "features": [
        "open",
        "high",
        "low",
        "close",
        "volume",
        "daily_return",
        "log_return",
        "volatility_5d",
        "volatility_10d",
        "volatility_20d",
        "annualized_volatility_20d",
        "sma_5",
        "sma_10",
        "sma_20",
        "sma_50",
        "price_to_sma_5",
        "price_to_sma_20",
        "price_to_sma_50",
        "momentum_5d",
        "momentum_10d",
        "momentum_20d",
        "daily_range",
        "overnight_gap",
        "close_position"
    ],
    "hidden_1": 64,
    "hidden_2": 32,
    "dropout_rate": 0.25,
    "batch_size": 64,
    "epochs": 40,
    "learning_rate": 0.001,
    "mc_samples": 100,
    "train_ratio": 0.8,
    "random_seed": 42,
    "device": "cpu"
}